        <mxCell id="b1zBAo0qaSXz0lg_emU8-60" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;Slot： 插槽、槽位、槽&lt;/li&gt;&lt;li&gt;Slot用于FIink 程序运行&lt;/li&gt;&lt;li&gt;Slot：是我们手动配置的，默认是1&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="205" y="-200" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-61" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;主从架构：&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;HDFS: NameNode、 DataNode&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Yarm: Resource Manager, Node Manager&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Spark: Master、 Worker&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Flink: JobManager、 TaskManager&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="480" y="-460" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dsmfFzbAbQ382pi9R3UA-6" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;edgeStyle=orthogonalEdgeStyle;elbow=vertical;curved=1;" edge="1" parent="1" source="dsmfFzbAbQ382pi9R3UA-1" target="dsmfFzbAbQ382pi9R3UA-2">
