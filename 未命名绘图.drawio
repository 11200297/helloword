        <mxCell id="b1zBAo0qaSXz0lg_emU8-5" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;MapReduce&lt;/font&gt;&lt;/b&gt;&lt;div&gt;（需要写代码）&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;hadoop1.x: hdfs、 mr&lt;/li&gt;&lt;li&gt;hadoop2.x: hdfs、 mr、 yarn&lt;/li&gt;&lt;li&gt;使用java编程的方式实现mr作业（开发笨重）&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-100" y="-1080" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b1zBAo0qaSXz0lg_emU8-6" target="b1zBAo0qaSXz0lg_emU8-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-6" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Hive&lt;/b&gt;&lt;/font&gt;&lt;div&gt;(只是写SQL)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;使用SQL的方式编写mr作业（开发简化）&lt;/li&gt;&lt;li&gt;Hive 默认的引擎是mr，可以切换tez和spark&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="340" y="-1080" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="b1zBAo0qaSXz0lg_emU8-7" target="b1zBAo0qaSXz0lg_emU8-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-7" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Tez&lt;/font&gt;&lt;/b&gt;&lt;div&gt;(MR1+MR2+MR3)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;将多个mr串行的组合到一起形成DAG （有向无环图）&lt;/li&gt;&lt;li&gt;并不能本质解决mr计算慢的问题 （磁盘计算lO）&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="780" y="-1080" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-8" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Spark&lt;/b&gt;&lt;/font&gt;&lt;div&gt;(内存计算，SQL)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;基于内存计算的spark应运而生&lt;/li&gt;&lt;li&gt;天生具备DAG的能力，将多个task串行起来组合到一起&lt;/li&gt;&lt;li&gt;同时也支持SQL的方式简化代码的编写&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="1220" y="-1080" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-12" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;离线计算&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="620" y="-1130" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-25" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;" parent="1" vertex="1">
          <mxGeometry x="95" y="-900" width="1250" height="370" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="b1zBAo0qaSXz0lg_emU8-27" target="b1zBAo0qaSXz0lg_emU8-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-27" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Storm&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;(真正的流式计算）&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;第一代实时计算框架（storm）&lt;/li&gt;&lt;li&gt;主要的编程语言是非主流编程语言用 Clojure 编写，使用成本过高&lt;/li&gt;&lt;li&gt;不支持窗口计算&lt;/li&gt;&lt;li&gt;JStorm是 Storm 的一个纯 Java 实现，旨在解决 Storm 的一些局限性&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="115" y="-830" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="b1zBAo0qaSXz0lg_emU8-29" target="b1zBAo0qaSXz0lg_emU8-30" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-29" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;SparkStreaming&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;(以微批的思想）&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;微批&lt;/li&gt;&lt;li&gt;时间驱动的&lt;/li&gt;&lt;li&gt;每隔一定时间拉取一下数据(5s, 10s， 1m)&lt;/li&gt;&lt;li&gt;微批的好处：吞吐量比较大，一次可能处理很大的数量&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="555" y="-830" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-30" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Flink&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;(真正的流式计算框架)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="995" y="-830" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-31" value="&lt;div&gt;阿里巴巴基于storm，研发了jstorm框架 （纯java语言编写），依然无法解决storm的本质痛点问题，因此阿里选型下一代的计算引擎，spark、flink ， flink是国际上用的最多的实时计算引擎，阿里巴巴基于当时不太成熟的flink做了大量的优化和改进，内部的版本称之为blink，到2019年&lt;span style=&quot;background-color: initial;&quot;&gt;阿里巴巴直接收购了flink的母公司 ，然后将blink和flink的源码进行了合并，形成当先的apacheflink，以及基于apacheflink的商业版阿里云flink&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="115" y="-660" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-32" value="&lt;div&gt;&lt;b&gt;什么时候该使用微批什么时候使用实时？&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;如果业务实时性要求非常高，比如每产生一条数据就要立刻马上处理使用flink，&lt;span style=&quot;background-color: initial;&quot;&gt;反之可以考虑使用sparkstreaming&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;flink目前是实时计算领域的首选！！！&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="995" y="-660" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b1zBAo0qaSXz0lg_emU8-33" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;实时计算&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="615" y="-890" width="200" height="30" as="geometry" />
        </mxCell>
